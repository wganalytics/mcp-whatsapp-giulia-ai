# PRJ-06 whatsapp — copie para .env e preencha com os dados da SUA instância Evolution.
# O .env real NÃO vai para o git (ver .gitignore). Este exemplo vai.

# URL base do servidor Evolution API (sem barra no final)
EVOLUTION_BASE_URL=http://localhost:8080
# API Key (global ou da instância) — header "apikey"
EVOLUTION_API_KEY=
# Nome da instância de WhatsApp já pareada
EVOLUTION_INSTANCE=
